def get_unwind(property_name, benchmark_name):
    key = (property_name, benchmark_name)
    if key in unwind_map:
        return unwind_map[key]
    else:
        raise ValueError(f"Unwind non trovato per property={property_name}, benchmark={benchmark_name}")
        
def get_round(property_name, benchmark_name):
    key = (property_name, benchmark_name)
    if key in round_map:
        return round_map[key]
    else:
        raise ValueError(f"Rounds non trovati per property={property_name}, benchmark={benchmark_name}")
        
