+ // Vero solo se la reason di v e' una clausola vera: un marker di teoria non e'
+ // un riferimento nella regione, e ca.lea() lo dereferenzierebbe fuori range.
+ // Non potendo essere un puntatore a clausola, non puo' mai coincidere con &c.
+ inline bool     Solver::reasonIsClause  (Var v) const {
+   const CRef cr = reason(v);
+   return cr != CRef_Undef && !isTheoryMarker(cr);
+ }
