+//=================================================================================================
+// DPLL(T): marker, reason pigre, propagazione a punto fisso.
+//
+// Portato da modsat (SAT Modulo SAT, Bayless et al. FMCAD'13), Alg. 2 e Alg. 3.
+// La reason di una propagazione di teoria e' costruita solo se l'analisi del
+// conflitto la chiede: e' questo che rende la propagazione di teoria piu'
+// economica delle clausole che la codificherebbero.
+
+//=================================================================================================
+// Questo solver come TEORIA di un altro: la catena di SAT Modulo SAT.
+//
+// Alg. 2 del paper (PROPAGATE_ALL) e' bidirezionale: gli assegnamenti passano
+// nei due sensi fino a punto fisso. Il modulo inferiore non decide mai da solo
+// -- riceve i letterali di interfaccia dal master come fatti (senza reason,
+// esattamente come le assumption di MiniSat), propaga, e o entra in conflitto
+// o produce nuovi letterali di interfaccia da rimandare in su.
+
+void Solver::attachTo(Solver *s, const vec<Var> &shared) {
+    super = s;
+    interface_var.growTo(nVars(), 0);
+    for(int i = 0; i < shared.size(); i++) {
+        const Var v = shared[i];
+        if(v < nVars())            interface_var[v] = 1;
+        if(v < s->nVars())         s->freezeVar(v);
+        if(v < nVars())            freezeVar(v);
+    }
+    // Registrare PRIMA: newReasonMarker cerca la teoria in `theories` per
+    // associarle il segnaposto, e non la troverebbe.
+    s->addTheory(this);
+    super_marker = s->newReasonMarker(this);
+    super_qhead = 0;
+    slave_reported = 0;
+
+    // Lista esplicita dell'interfaccia (per il gate) + soglia da ambiente.
+    interface_list.clear();
+    for(int i = 0; i < shared.size(); i++)
+        if(shared[i] < nVars()) interface_list.push(shared[i]);
+    if(const char *g = getenv("LAZYPO_SMS_GATE")) sms_gate = atoi(g);
+
+    // Quali variabili compaiono davvero in questo modulo.
+    module_var.growTo(nVars(), 0);
+    for(int i = 0; i < clauses.size(); i++) {
+        const Clause &c = ca[clauses[i]];
+        for(int j = 0; j < c.size(); j++) module_var[var(c[j])] = 1;
+    }
+    for(int i = 0; i < trail.size(); i++) module_var[var(trail[i])] = 1;
+}
+
+void Solver::backtrackTheory(int level) {
+    cancelUntil(level);
+    // Il trail del master si e' accorciato: riconsumarlo da capo dal punto in
+    // cui e' ancora valido.
+    if(super != nullptr && super_qhead > super->trail.size())
+        super_qhead = super->trail.size();
+    if(slave_reported > trail.size())
+        slave_reported = trail.size();
+}
+
+void Solver::interfaceConflict(CRef confl, vec<Lit> &out) {
+    out.clear();
+    if(decisionLevel() == 0) return;   // insoddisfacibile di suo: clausola vuota
+
+    seen.growTo(nVars(), 0);
+    int marked = 0;
+    {
+        const Clause &c = ca[confl];
+        for(int i = 0; i < c.size(); i++)
+            if(!seen[var(c[i])] && level(var(c[i])) > 0) { seen[var(c[i])] = 1; marked++; }
+    }
+    // Risoluzione all'indietro lungo il trail: ogni letterale con una reason
+    // viene sostituito dalle sue premesse; restano solo i fatti ricevuti.
+    for(int i = trail.size() - 1; i >= trail_lim[0] && marked > 0; i--) {
+        const Var x = var(trail[i]);
+        if(!seen[x]) continue;
+        seen[x] = 0; marked--;
+        const CRef r = reason(x);
+        if(r == CRef_Undef) {
+            out.push(~trail[i]);       // fatto ricevuto dal master: lo neghiamo
+        } else {
+            const Clause &c = ca[r];
+            for(int j = ((c.size() == 2) ? 0 : 1); j < c.size(); j++)
+                if(!seen[var(c[j])] && level(var(c[j])) > 0) { seen[var(c[j])] = 1; marked++; }
+        }
+    }
+    for(int i = 0; i < trail.size(); i++) seen[var(trail[i])] = 0;
+}
+
+int Solver::unassignedInterface() const {
+    int n = 0;
+    for(int i = 0; i < interface_list.size(); i++)
+        if(super->value(interface_list[i]) == l_Undef) n++;
+    return n;
+}
+
+bool Solver::propagateTheory(vec<Lit> &conflict) {
+    if(super == nullptr) return true;
+    stats_theory_calls++;
+
+    // Gate LAZYPO_SMS_GATE: finche' restano piu' di `sms_gate` variabili di
+    // interfaccia libere lo slave sta inerte; quando conviene valutarlo lo si
+    // valuta FLAT -- stato scartato e ricostruito dall'assegnamento corrente del
+    // master, a un solo livello -- cosi' non c'e' stato incrementale che possa
+    // divergere dal master dopo un backtrack. Sound: la canonicalita' e'
+    // pruning-only, saltare potatura non cambia il verdetto.
+    if(sms_gate >= 0) {
+        if(unassignedInterface() > sms_gate) {
+            stats_theory_calls_gated++;
+            return true;
+        }
+        bool changed = gate_last_iface.size() != interface_list.size();
+        for(int i = 0; !changed && i < interface_list.size(); i++)
+            if(gate_last_iface[i] != super->value(interface_list[i])) changed = true;
+        if(!changed) {
+            stats_theory_calls_gated++;
+            return true;
+        }
+
+        cancelUntil(0);
+        newDecisionLevel();   // livello 1: interfaceConflict scarta il livello 0
+        for(int i = 0; i < super->trail.size(); i++) {
+            const Lit l = super->trail[i];
+            const Var v = var(l);
+            if(v >= interface_var.size() || !interface_var[v]) continue;
+            if(value(l) == l_True) continue;
+            if(value(l) == l_False) {
+                const CRef r = reason(v);
+                conflict.clear();
+                if(r != CRef_Undef) interfaceConflict(r, conflict);
+                if(!conflict.size()) conflict.push(~l);
+                stats_slave_conflicts++;
+                gate_last_iface.clear();
+                return false;
+            }
+            uncheckedEnqueue(l);
+        }
+        stats_theory_calls_fed++;
+        const CRef gconfl = propagate();
+        if(gconfl != CRef_Undef) {
+            interfaceConflict(gconfl, conflict);
+            stats_slave_conflicts++;
+            gate_last_iface.clear();
+            return false;
+        }
+        gate_last_iface.growTo(interface_list.size());
+        for(int i = 0; i < interface_list.size(); i++)
+            gate_last_iface[i] = super->value(interface_list[i]);
+        return true;
+    }
+
+    const int lits_before = trail.size();
+
+    // Allinea i livelli di decisione a quelli del master, cosi' il backtrack
+    // del master si traduce direttamente in un backtrack qui.
+    while(decisionLevel() < super->decisionLevel())
+        newDecisionLevel();
+
+    // master -> slave
+    while(super_qhead < super->trail.size()) {
+        const Lit l = super->trail[super_qhead++];
+        const Var v = var(l);
+        if(v >= interface_var.size() || !interface_var[v]) continue;
+        if(value(l) == l_True)  continue;
+        if(value(l) == l_False) {
+            // Il master afferma l, lo slave aveva gia' dedotto ~l: conflitto
+            // gia' spiegabile risalendo dalla reason di ~l.
+            const CRef r = reason(v);
+            if(r == CRef_Undef) { conflict.clear(); conflict.push(~l); }
+            else                interfaceConflict(r, conflict);
+            if(!conflict.size()) conflict.push(~l);
+            stats_slave_conflicts++;
+            return false;
+        }
+        uncheckedEnqueue(l);   // fatto ricevuto: nessuna reason, come un'assumption
+    }
+
+    if(trail.size() > lits_before) {
+        stats_theory_calls_fed++;
+        stats_theory_lits_in += trail.size() - lits_before;
+    }
+
+    const CRef confl = propagate();
+    if(confl != CRef_Undef) {
+        interfaceConflict(confl, conflict);
+        stats_slave_conflicts++;
+        return false;
+    }
+
+    // slave -> master: le nuove deduzioni sull'interfaccia risalgono con un
+    // segnaposto; la clausola che le spiega si costruira' solo se servira'.
+    for(; slave_reported < trail.size(); slave_reported++) {
+        const Lit l = trail[slave_reported];
+        const Var v = var(l);
+        if(v >= interface_var.size() || !interface_var[v]) continue;
+        if(reason(v) == CRef_Undef) continue;         // e' un fatto ricevuto
+        if(super->value(l) != l_Undef) continue;
+        super->enqueueTheory(l, super_marker);
+        stats_slave_up++;
+        // A livello 0 il letterale entra nel master senza che nessuna clausola
+        // lo spieghi mai: un conflitto a livello 0 esce da search() senza
+        // passare da analyze(), quindi il segnaposto non viene materializzato.
+        // E' l'unica via per cui lo slave puo' contribuire alla refutazione
+        // restando invisibile.
+        if(super->decisionLevel() == 0) stats_slave_up_level0++;
+    }
+    return true;
+}
+
+bool Solver::solveTheory(vec<Lit> &conflict) {
+    if(!propagateTheory(conflict))
+        return false;
+    // Il modulo di canonicalita' non ha variabili libere proprie: i tag sono
+    // funzioni dell'interfaccia, quindi dopo la propagazione tutto e' deciso.
+    // Se cosi' non fosse, accettare l'assegnamento costa POTATURA, non
+    // correttezza: il master da solo e' l'encoding plain completo, quindi ogni
+    // suo modello e' un'esecuzione reale. Il contatore dice se succede mai.
+    int undecided = 0, undecided_por = 0;
+    for(int v = 0; v < nVars(); v++)
+        if(assigns[v] == l_Undef && v < module_var.size() && module_var[v] &&
+           (v >= interface_var.size() || !interface_var[v])) {
+            undecided++;
+            // Il master porta la classificazione di provenienza (set_por_variable,
+            // dal mark_por_variables della frontend). La numerazione e' condivisa,
+            // quindi da qui si vede se una variabile e' un tag POR vero o una
+            // intermedia Tseitin senza nome.
+            if(super != nullptr && v < super->por_var.size() && super->por_var[v])
+                undecided_por++;
+            if(slave_undecided_vars.size() < 40) slave_undecided_vars.push(v);
+        }
+    if(undecided > 0) {
+        stats_slave_incomplete++;
+        stats_slave_undecided_por += undecided_por;
+        stats_slave_undecided_max =
+            (uint64_t)undecided > stats_slave_undecided_max ? (uint64_t)undecided
+                                                            : stats_slave_undecided_max;
+    }
+    return true;
+}
+
+void Solver::buildTheoryReason(Lit p, vec<Lit> &reason_out) {
+    // p e' stato propagato dallo slave verso il master. La sua spiegazione e'
+    // la clausola di interfaccia: p oppure la negazione dei fatti ricevuti che
+    // lo hanno forzato.
+    reason_out.clear();
+    reason_out.push(p);
+    const Var v = var(p);
+    const CRef r = (v < nVars()) ? reason(v) : CRef_Undef;
+    if(r == CRef_Undef || value(p) != l_True) {
+        // Non abbiamo piu' lo stato che l'ha prodotto: ripiego conservativo,
+        // la negazione dell'intero prefisso ricevuto.
+        for(int i = trail_lim.size() ? trail_lim[0] : 0; i < trail.size(); i++)
+            if(reason(var(trail[i])) == CRef_Undef && trail[i] != p)
+                reason_out.push(~trail[i]);
+        return;
+    }
+    vec<Lit> cause;
+    interfaceConflict(r, cause);
+    for(int i = 0; i < cause.size(); i++)
+        if(var(cause[i]) != v) reason_out.push(cause[i]);
+}
+
+CRef Solver::newReasonMarker(Theory *forTheory) {
+    markers.push(ca.makeMarkerReference());
+    const int num = CRef_Undef - markers.last() - 1;
+    marker_index.growTo(num + 1, -1);
+    for(int i = 0; i < theories.size(); i++)
+        if(theories[i] == forTheory) { marker_index[num] = i; break; }
+    assert(marker_index[num] >= 0);
+    return markers.last();
+}
+
+CRef Solver::resolveReason(Var x) {
+    const CRef cr = vardata[x].reason;
+    if(!isTheoryMarker(cr))
+        return cr;
+
+    const Lit p = mkLit(x, value(x) == l_False); // il letterale assegnato vero
+    theory_reason.clear();
+    Theory *const t = theories[getTheory(cr)];
+    if(Solver *const sub = dynamic_cast<Solver *>(t)) sub->stats_slave_reasons++;
+    t->buildTheoryReason(p, theory_reason);
+    assert(theory_reason.size() >= 2);
+    assert(theory_reason[0] == p);
+
+    // Learnt, non permanente: finche' e' la reason di x resta protetta da
+    // locked(), che vede theory_reason[0] == p e vardata[x].reason == questa
+    // clausola. Appena x si disassegna, reduceDB puo' recuperarla come una
+    // learnt qualsiasi. Tenerle in `clauses` le rendeva indistruttibili: su
+    // triangular-longest-2 erano 100816 clausole permanenti in piu' nel master.
+    const CRef reason = ca.alloc(theory_reason, true);
+    ca[reason].setLBD(computeLBD(ca[reason]));
+    ca[reason].setOneWatched(false);
+    learnts.push(reason);
+    claBumpActivity(ca[reason]);
+    attachClause(reason);
+    vardata[x].reason = reason;
+    return reason;
+}
+
+CRef Solver::addTheoryConflict(vec<Lit> &ps) {
+    if(ps.size() == 0) {
+        // Clausola vuota: il modulo inferiore e' insoddisfacibile di suo,
+        // indipendentemente dall'interfaccia. L'intera formula lo e'.
+        ok = false;
+        return CRef_Undef;
+    }
+    if(ps.size() == 1) {
+        // Fatto di livello 0: non c'e' clausola da restituire come conflitto.
+        cancelUntil(0);
+        if(value(ps[0]) == l_False) { ok = false; return CRef_Undef; }
+        if(value(ps[0]) == l_Undef) uncheckedEnqueue(ps[0]);
+        return CRef_Undef;
+    }
+    // La spiegazione di un conflitto di teoria puo' avere il suo letterale di
+    // livello massimo sotto decisionLevel() (lo slave gated lo trova dopo che il
+    // master e' gia' sceso). analyze() pretende >=1 letterale al livello
+    // corrente: si backjumpa al livello massimo della clausola. Sul percorso
+    // non-gated k == decisionLevel() e questo non fa nulla.
+    int k = 0;
+    for(int i = 0; i < ps.size(); i++)
+        if(value(ps[i]) != l_Undef && level(var(ps[i])) > k)
+            k = level(var(ps[i]));
+    if(k < decisionLevel())
+        cancelUntil(k);
+    const CRef cr = ca.alloc(ps, false);
+    clauses.push(cr);
+    attachClause(cr);
+    return cr;
+}
+
+CRef Solver::propagateTheories() {
+    for(int i = 0; i < theories.size(); i++) {
+        theory_conflict.clear();
+        if(!theories[i]->propagateTheory(theory_conflict))
+            return addTheoryConflict(theory_conflict);
+    }
+    return CRef_Undef;
+}
+
+CRef Solver::propagateAll() {
+    CRef confl = propagate();
+    if(theories.size() == 0)
+        return confl;
+    while(confl == CRef_Undef) {
+        const int before = trail.size();
+        confl = propagateTheories();
+        if(confl != CRef_Undef || !ok)
+            break;
+        if(trail.size() == before)
+            break;              // punto fisso fra formula e teorie
+        confl = propagate();
+    }
+    return confl;
+}
+
+CRef Solver::checkTheoriesOnModel() {
+    for(int i = 0; i < theories.size(); i++) {
+        // Un modulo di sola potatura non puo' invalidare un modello del master.
+        if(theories[i]->isPruningOnly()) { stats_model_checks_skipped++; continue; }
+        theory_conflict.clear();
+        if(!theories[i]->solveTheory(theory_conflict))
+            return addTheoryConflict(theory_conflict);
+    }
+    return CRef_Undef;
+}
