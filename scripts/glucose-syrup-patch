diff -ruN a/core/Theory.h b/core/Theory.h
--- a/core/Theory.h	1970-01-01 01:00:00.000000000 +0100
+++ b/core/Theory.h	2026-09-08 11:44:24.548413420 +0200
@@ -0,0 +1,57 @@
+/*****************************************************************************
+Theory.h -- interfaccia DPLL(T) minimale per Glucose.
+
+Portata da modsat (SAT Modulo SAT, Bayless et al.), che la usava su un core
+MiniSat 2.2. Glucose e' lo stesso core, quindi l'interfaccia passa invariata.
+
+Il motivo per cui serve qui: i vincoli di canonicalita' del POR sono una
+FUNZIONE dello schedule, non una scelta libera. La campagna lo ha misurato --
+con CS-first attivo, `fallback_por = 0` in ogni run: il solver non ha mai
+deciso su una variabile di tag, le ha sempre e solo propagate. Una funzione si
+calcola, non si codifica in clausole: la CNF paga +70% di clausole per
+esprimere quello che una procedura calcola in O(eventi).
+*****************************************************************************/
+
+#ifndef Glucose_Theory_h
+#define Glucose_Theory_h
+
+#include "mtl/Vec.h"
+#include "core/SolverTypes.h"
+
+namespace Glucose {
+
+class Theory {
+public:
+    virtual ~Theory() {}
+
+    /// Il solver e' tornato al livello `level`: scarta lo stato piu' recente.
+    virtual void backtrackTheory(int level) = 0;
+
+    /// Propaga sull'assegnamento corrente. Restituisce false se la teoria e'
+    /// in conflitto, riempiendo `conflict` con una clausola falsificata
+    /// (letterali della teoria, tutti falsi sotto l'assegnamento corrente).
+    virtual bool propagateTheory(vec<Lit> &conflict) = 0;
+
+    /// Controllo finale su un assegnamento totale.
+    virtual bool solveTheory(vec<Lit> &conflict) = 0;
+
+    /// True se questo modulo puo' solo TOGLIERE modelli al master, mai
+    /// aggiungerne. Per un modulo cosi' un modello del master e' gia' una
+    /// soluzione del problema, e non ha senso chiederne conferma: la modifica 2
+    /// di Alg. 3 serve nel caso generale, dove i moduli definiscono INSIEME la
+    /// soddisfacibilita'. La canonicalita' del POR e' di questo tipo -- il
+    /// master da solo e' l'encoding completo, quindi ogni suo modello e' una
+    /// esecuzione reale.
+    virtual bool isPruningOnly() const { return false; }
+
+    /// Costruisce PIGRAMENTE la reason della propagazione di `p`.
+    /// reason[0] deve essere p; il resto sono letterali falsi.
+    /// E' pigra perche' la maggior parte delle reason non viene mai richiesta:
+    /// e' questo che rende la propagazione di teoria piu' economica delle
+    /// clausole che la codificherebbero.
+    virtual void buildTheoryReason(Lit p, vec<Lit> &reason) = 0;
+};
+
+} // namespace Glucose
+
+#endif
