+/*****************************************************************************
+ShadowTheory.h -- teoria di validazione per l'impalcatura DPLL(T).
+
+Non serve a risolvere niente: serve a ESERCITARE la macchina dei marker.
+
+Prende N clausole dalla formula e le SPOSTA dentro di se', togliendole dal
+master. L'insieme delle clausole non cambia -- cambia solo da che parte della
+partizione stanno -- quindi la teoria e' semanticamente neutra per costruzione,
+ma e' l'unica a farle rispettare: deve propagare e deve entrare in conflitto.
+E' un mini-SMS con una partizione arbitraria.
+
+Copiarle e basta, lasciandole anche nel master, NON avrebbe validato niente:
+la teoria viene chiamata solo dopo che propagate() ha raggiunto il punto fisso,
+quindi nessuna clausola gia' presente nel master puo' essere unitaria in quel
+momento. Zero propagazioni, zero marker, percorso rischioso non eseguito.
+*****************************************************************************/
+
+#ifndef Glucose_ShadowTheory_h
+#define Glucose_ShadowTheory_h
+
+#include "core/Solver.h"
+#include "core/Theory.h"
+
+namespace Glucose {
+
+class ShadowTheory : public Theory {
+public:
+    explicit ShadowTheory(Solver &s) : S(s), marker(CRef_Undef) {}
+    ~ShadowTheory() override { for(int i = 0; i < cls.size(); i++) delete cls[i]; }
+
+    /// Sposta fino a `max_clauses` clausole dal master dentro la teoria.
+    /// Va chiamata dopo addClause() e prima di solve(), a livello 0.
+    void setup(int max_clauses) {
+        marker = S.newReasonMarker(this);
+        reason_of.growTo(S.nVars(), -1);
+
+        vec<CRef> taken;
+        int keep = 0;
+        for(int i = 0; i < S.clauses.size(); i++) {
+            const CRef cr = S.clauses[i];
+            const Clause &c = S.ca[cr];
+            // Corte: la scansione lineare della teoria resta economica.
+            if(cls.size() < max_clauses && c.size() >= 2 && c.size() <= 4) {
+                vec<Lit> *v = new vec<Lit>();
+                for(int j = 0; j < c.size(); j++) {
+                    v->push(c[j]);
+                    S.freezeVar(var(c[j]));
+                }
+                cls.push(v);
+                taken.push(cr);
+            } else {
+                S.clauses[keep++] = cr;
+            }
+        }
+        S.clauses.shrink(S.clauses.size() - keep);
+        for(int i = 0; i < taken.size(); i++) {
+            S.detachClause(taken[i], true);
+            S.ca.free(taken[i]);
+        }
+    }
+
+    int size() const { return cls.size(); }
+    uint64_t propagations() const { return n_props; }
+    uint64_t conflicts() const { return n_confl; }
+    uint64_t reasons_built() const { return n_reasons; }
+
+    void backtrackTheory(int) override {}   // lo stato vive nel trail del solver
+
+    bool propagateTheory(vec<Lit> &conflict) override {
+        for(int i = 0; i < cls.size(); i++) {
+            const vec<Lit> &c = *cls[i];
+            Lit unassigned = lit_Undef;
+            int n_false = 0;
+            bool satisfied = false;
+            for(int j = 0; j < c.size(); j++) {
+                const lbool v = S.value(c[j]);
+                if(v == l_True) { satisfied = true; break; }
+                if(v == l_False) n_false++;
+                else unassigned = c[j];
+            }
+            if(satisfied)
+                continue;
+            if(n_false == c.size()) {           // clausola falsificata
+                conflict.clear();
+                for(int j = 0; j < c.size(); j++) conflict.push(c[j]);
+                n_confl++;
+                return false;
+            }
+            if(n_false == c.size() - 1) {       // unitaria
+                reason_of.growTo(S.nVars(), -1);
+                reason_of[var(unassigned)] = i;
+                S.enqueueTheory(unassigned, marker);
+                n_props++;
+            }
+        }
+        return true;
+    }
+
+    bool solveTheory(vec<Lit> &conflict) override {
+        return propagateTheory(conflict);
+    }
+
+    void buildTheoryReason(Lit p, vec<Lit> &reason) override {
+        n_reasons++;
+        const int i = reason_of[var(p)];
+        assert(i >= 0);
+        const vec<Lit> &c = *cls[i];
+        reason.clear();
+        reason.push(p);                          // reason[0] deve essere p
+        for(int j = 0; j < c.size(); j++)
+            if(c[j] != p) reason.push(c[j]);
+    }
+
+private:
+    Solver &S;
+    CRef marker;
+    vec<vec<Lit> *> cls;
+    vec<int> reason_of;   // var -> indice della clausola ombra che l'ha propagata
+    uint64_t n_props = 0, n_confl = 0, n_reasons = 0;
+};
+
+} // namespace Glucose
+
+#endif
